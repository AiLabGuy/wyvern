#
# Single source of truth for the shipped product name, bundle id, and version.
# Swift display strings live in AppInfo; this file is what scripts, Info.plist
# generation, project.yml checks, and CI read.
# PRODUCT_NAME is the legal and packaging name (notices, DMG volume, Xcode product).
# DISPLAY_NAME is the user-facing name (Dock, Finder, app menu, window titles).
# BUNDLE_NAME is the short bundle name and matches DISPLAY_NAME.
PRODUCT_NAME="Wyvern Browser"
DISPLAY_NAME="Wyvern"
BUNDLE_NAME="Wyvern"
BUNDLE_ID=com.example.wyvern
VERSION=0.1.0
EXECUTABLE_NAME="Wyvern Browser"
APP_BUNDLE="Wyvern Browser.app"
DMG_BASENAME=WyvernBrowser
SWIFT_PRODUCT=App1
SCREENSHOTS_ZIP=WyvernBrowser-screenshots.zip
DMG_ZIP=WyvernBrowser-dmg.zip
ARTIFACT_NAME=WyvernBrowser-dmg
# Built-in (default) update source: the latest GitHub release of this repository.
# Default: the official AiLabGuy/wyvern releases. Forks: replace with your own GitHub account and repo name
# (the release workflow substitutes them from GITHUB_REPOSITORY automatically).
# Any HTTPS host serving latest.json works here too (docs/UPDATES.md). While the URL or key still
# contains a placeholder, scripts/build-app.sh builds the app with no built-in source.
UPDATE_FEED_URL=https://github.com/AiLabGuy/wyvern/releases/latest/download/latest.json
# minisign public key (legacy Ed, starts with RW) that must sign every release from the built-in source.
# PLACEHOLDER: generate a fresh release key with scripts/new-release-key.sh. Never reuse a dev key.
UPDATE_PUBLIC_KEY=RELEASE_PUBLIC_KEY_PLACEHOLDER
# Dev builds only (WYVERN_DEV_UPDATER=1): 1 allows a private-network http:// built-in source.
UPDATE_DEV_SOURCE=
